# Use 5001 on macOS if port 5000 is taken by AirPlay Receiver
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/eventisa?replicaSet=rs0
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
API_PREFIX=/api

# Rate limit (production only — disabled in development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (future — session/cache)
# REDIS_URL=redis://localhost:6379

# Email — Gmail SMTP (use App Password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=eventisa.contact@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Eventisa <eventisa.contact@gmail.com>"
FRONTEND_URL=http://localhost:3000

# Payments — mock mode for local dev (no credentials required)
PAYMENT_MODE=mock

# Feature flags — set true when credentials are added + PAYMENT_MODE=live
ENABLE_SSL=false
ENABLE_BKASH=false
ENABLE_NAGAD=false

# SSLCommerz (future)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# bKash (future)
BKASH_APP_KEY=
BKASH_SECRET=

# Nagad (future)
NAGAD_MERCHANT_ID=

# Uploads — local dev or Cloudinary in production
UPLOAD_PROVIDER=local
UPLOAD_MAX_MB=8
API_PUBLIC_URL=http://localhost:5001
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=eventisa
